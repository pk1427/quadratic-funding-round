pragma solidity ^0.8.24;
import {QFRound} from "../src/QFRound.sol";
interface Vm{function warp(uint)external;function prank(address)external;function deal(address,uint)external;}
contract QFRoundTest{Vm constant vm=Vm(address(uint160(uint(keccak256("hevm cheat code")))));address op=address(1);address alice=address(2);address bob=address(3);uint constant START=2_000_000_000;uint constant END=2_000_001_000;QFRound q;function setUp()public{vm.warp(START-1);q=new QFRound(op,START,END,keccak256(bytes.concat(keccak256(abi.encode(alice)))));vm.prank(op);q.registerProject(payable(bob),"docs");vm.deal(op,10 ether);vm.deal(alice,10 ether);vm.prank(op);q.fundPool{value:1 ether}();}function testEligibleContributionAndDelta()public{vm.warp(START);vm.prank(alice);q.contribute{value:1 ether}(0,new bytes32[](0));uint a=q.sumSqrtOf(0);vm.prank(alice);q.contribute{value:3 ether}(0,new bytes32[](0));require(q.sumSqrtOf(0)==q.sqrt(4 ether*1e18)&&q.sumSqrtOf(0)>a,"delta");}function testIneligibleAndLateRevert()public{vm.warp(START);vm.prank(bob);(bool ok,)=address(q).call{value:1}(abi.encodeCall(q.contribute,(0,new bytes32[](0))));require(!ok);vm.warp(END+1);vm.prank(alice);(ok,)=address(q).call{value:1}(abi.encodeCall(q.contribute,(0,new bytes32[](0))));require(!ok);}function testEarlyFinalizeAndDoubleWithdraw()public{vm.warp(START);vm.prank(alice);q.contribute{value:1 ether}(0,new bytes32[](0));(bool ok,)=address(q).call(abi.encodeCall(q.finalizeMatches,()));require(!ok);vm.warp(END+1);q.finalizeMatches();vm.prank(bob);q.withdraw(0);vm.prank(bob);(ok,)=address(q).call(abi.encodeCall(q.withdraw,(0)));require(!ok);}}
